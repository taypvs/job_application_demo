APP_NAME=求人管理
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
CANDIDATE_URL=http://localhost:8080
ADMIN_URL=http://localhost:8081

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=jobapply
DB_USERNAME=jobapply
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@canal.example.jp"
MAIL_FROM_NAME="${APP_NAME}"

# MinIO (docker compose) or real AWS S3
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio12345
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=jobapply
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Leave blank to use local keyword matching / database search
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Pinecone serverless index host. Dimension must match the embedding model (1536 for text-embedding-3-small).
PINECONE_API_KEY=
PINECONE_HOST=
PINECONE_NAMESPACE=jobapply
